<% provide(:title, t('passkeys.delete_title')) %>
<div class="container passkeys-page passkeys-page-form">
  <p><%= link_to t('passkeys.back_to_passkeys'), passkeys_path %></p>
  <h1><%= t('passkeys.delete_title') %></h1>
  <p><strong><%= @passkey.name %></strong></p>
  <p><%= t('passkeys.delete_effect') %></p>
  <p><%= t('passkeys.delete_saved_copy') %></p>
  <% if current_user.passkeys.one? %>
    <%= alert :warning, t(current_user.two_factor_enabled? ? 'passkeys.delete_last_with_otp' : 'passkeys.delete_last') %>
  <% end %>
  <% if @identity_error %>
    <%= alert :danger, @identity_error %>
  <% end %>
  <%= form_tag passkey_path(@passkey), method: :delete do %>
    <%= render 'identity_fields', prefix: "passkey_#{@passkey.id}" %>
    <div class="passkeys-form-actions">
      <%= submit_tag t('passkeys.delete'), class: 'btn btn-danger' %>
      <%= link_to t('passkeys.cancel'), passkeys_path, class: 'btn btn-default' %>
    </div>
  <% end %>
</div>
