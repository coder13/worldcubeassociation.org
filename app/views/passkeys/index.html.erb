<% provide(:title, t('passkeys.title')) %>
<div class="container">
  <h1><%= t('passkeys.title') %></h1>
  <p><%= t('passkeys.description') %></p>
  <p><%= link_to t('passkeys.back'), edit_user_path(current_user) %></p>

  <% if @passkeys.empty? %>
    <p><%= t('passkeys.empty') %></p>
  <% end %>
  <% @passkeys.each do |passkey| %>
    <div class="panel panel-default">
      <div class="panel-heading"><%= passkey.name %></div>
      <div class="panel-body">
        <p><%= t('passkeys.created', date: l(passkey.created_at, format: :short)) %></p>
        <p><%= passkey.last_used_at ? t('passkeys.last_used', date: l(passkey.last_used_at, format: :short)) : t('passkeys.never_used') %></p>
        <%= form_tag passkey_path(passkey), method: :delete do %>
          <%= render 'identity_fields', prefix: "passkey_#{passkey.id}" %>
          <%= submit_tag t('passkeys.delete'), class: 'btn btn-danger', data: { confirm: t('passkeys.delete_confirm') } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <h2><%= t('passkeys.add') %></h2>
  <%= form_tag passkeys_path, data: { passkey_form: 'registration', options_url: registration_options_passkeys_path, error: t('passkeys.error'), cancelled: t('passkeys.cancelled') } do %>
    <div class="form-group">
      <%= label_tag :name, t('passkeys.name') %>
      <%= text_field_tag :name, nil, maxlength: Passkey::NAME_MAX_LENGTH, required: true, class: 'form-control' %>
    </div>
    <%= render 'identity_fields', prefix: 'new_passkey' %>
    <%= submit_tag t('passkeys.add'), class: 'btn btn-primary', disabled: true, data: { passkey_submit: true } %>
    <p class="help-block" data-passkey-unsupported><%= t('passkeys.unsupported') %></p>
    <p role="alert" class="text-danger" data-passkey-error></p>
  <% end %>
</div>
<%= javascript_include_tag 'passkeys', defer: true %>
